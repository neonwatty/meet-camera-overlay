{
  "name": "meet-camera-overlay",
  "version": "1.0.0",
  "description": "Chrome extension that adds image overlays to your Google Meet camera feed",
  "scripts": {
    "dev:wall-art": "npx vite prototype/multi-region-art --port 5173 --open",
    "dev:rich-content": "npx vite prototype/rich-content --port 5174 --open",
    "dev:region-content": "npx vite prototype/region-content --port 5176 --open",
    "dev:unified-effects": "npx vite prototype/unified-effects --open",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:integration": "playwright test",
    "test:integration:ui": "playwright test --ui",
    "test:visual": "node tests/visual/generate-demo.js",
    "generate:auras": "node scripts/generate-aura.js",
    "convert:png-to-gif": "node scripts/png-to-gif.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --project jsconfig.json",
    "knip": "knip",
    "prepare": "husky"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.21"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.2",
    "@commitlint/config-conventional": "^20.4.2",
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.40.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/github": "^12.0.6",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "@types/chrome": "^0.1.32",
    "canvas": "^3.2.0",
    "eslint": "^9.39.2",
    "eslint-plugin-security": "^3.0.1",
    "gifencoder": "^2.0.1",
    "husky": "^9.1.7",
    "knip": "^5.79.0",
    "semantic-release": "^25.0.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^1.0.0"
  },
  "type": "module"
}
