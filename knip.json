{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "popup.js",
    "content.js",
    "inject.js",
    "background.js",
    "lib/*.js",
    "scripts/*.js"
  ],
  "project": [
    "**/*.js"
  ],
  "ignore": [
    "tests/**",
    "node_modules/**",
    "dev/**",
    "dev-assets/**",
    "prototype/**"
  ],
  "ignoreDependencies": [
    "@commitlint/cli",
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    "@semantic-release/github",
    "husky",
    "semantic-release"
  ],
  "ignoreBinaries": [
    "commitlint",
    "husky",
    "semantic-release"
  ]
}
